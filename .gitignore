# Built binaries and WebAssembly output
/ownframe
/dist/
/tmp/
*.exe
*.wasm
*.aar
*.xcframework

# Release binary for the player example
/examples/spotify-player/spotify-player

# Go test and editor leftovers
*.test
*.out
.DS_Store
temp
# Android and Gradle build state
**/.gradle/
**/build/
**/local.properties
# New unsigned and debug APKs stay local; signed reference builder APKs are committed.
examples/*/android/artifacts/*-unsigned.apk
examples/*/android/artifacts/*-debug.apk
# Teams example SQLite state
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Temporary packages used to compile documentation fragments
/.doc-snippets-*/

# Python maintenance-check bytecode
__pycache__/

# Website starter demos distributed with the generated site. docs/ stays
# committed because GitHub Pages serves it directly.
!docs/demos/workspace-inspector/demo.wasm
!docs/demos/telegram/ownframe.wasm

!docs/demos/expense-tracker/demo.wasm

!docs/demos/hello/demo.wasm

# Copies below are regenerated by `npm run build`
# (frontend/scripts/build-demo.mjs) before every vite build, and site-check
# only snapshots docs/, so versioning them only fuels cross-PR binary
# conflicts. The wispr-flow binary is the exception: no build step produces
# it, so it stays tracked.
frontend/public/demo/demo.wasm
frontend/public/demo/wasm_exec.js
frontend/public/demos/expense-tracker/demo.wasm
frontend/public/demos/expense-tracker/wasm_exec.js
frontend/public/demos/hello/demo.wasm
frontend/public/demos/hello/wasm_exec.js
frontend/public/demos/spotify-player/ownframe.wasm.gz
frontend/public/demos/spotify-player/wasm_exec.js
frontend/public/demos/telegram/ownframe.wasm
frontend/public/demos/telegram/wasm_exec.js
frontend/public/demos/workspace-inspector/demo.wasm
frontend/public/demos/workspace-inspector/wasm_exec.js

# Local AI component reference screenshots
/examples/AI/
