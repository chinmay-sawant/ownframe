//kage:unit pixels
package main

// The finish: the scene (image0), its colors parted a little toward the
// edges as a lens parts them, the glow (image1) spread wide over it,
// darker corners and a film's grain.

var Time float

func hash12(p vec2) float {
	p3 := fract(p.xyx * 0.1031)
	p3 += dot(p3, p3.yzx+33.33)
	return fract((p3.x + p3.y) * p3.z)
}

func Fragment(dst vec4, pos vec2) vec4 {
	size := imageDstSize()
	uv := pos / size
	c := uv - 0.5
	src := imageSrc0Size()
	split := c * dot(c, c) * 0.018
	col := vec3(
		imageSrc0At((uv-split)*src).r,
		imageSrc0At(uv*src).g,
		imageSrc0At((uv+split)*src).b)

	glow := imageSrc1Size()
	at := uv * glow
	bloom := imageSrc1At(at).rgb * 0.4
	for i := 0; i < 12; i++ {
		f := float(i)
		a := f * 2.39996
		// The glow buffer is the upsampled quarter-res bloom, so its taps
		// are scaled by 4 to keep the original quarter-res spiral spread.
		r := (1.5 + f*0.7) * 4.0
		bloom += imageSrc1At(at+r*vec2(cos(a), sin(a))).rgb * 0.1 * exp(-f*0.12)
	}
	col = 1 - (1-col)*(1-min(bloom*1.1, 1))

	col *= 0.25 + 0.75*pow(16*uv.x*uv.y*(1-uv.x)*(1-uv.y), 0.22)
	col += (hash12(dst.xy+fract(Time)*131) - 0.5) / 96
	return vec4(clamp(col, 0, 1), 1)
}
