{
  "name": "ownframe-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "prebuild": "npm run build:demo",
    "build:demo": "node scripts/build-demo.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/*.test.js",
    "check:site": "node scripts/check-site.mjs",
    "capture:demo": "node scripts/check-site.mjs --capture-demo",
    "lint": "eslint ."
  },
  "dependencies": {
    "highlight.js": "11.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
